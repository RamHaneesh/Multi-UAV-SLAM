<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>iris_control</name>
  <version>0.0.0</version>
  <description>Control for single Iris UAV in (Gazebo Harmonic)+ROS2+Ardupilot</description>
  <maintainer email="vigyannveshi@gmail.com">Rudraksha Bandodkar</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msg</depend>
  <depend>math</depend>
  <depend>json</depend>
  <depend>sys</depend>
  <depend>termios</depend>
  <depend>tty</depend>
  <depend>select</depend>
  <depend>enum</depend>
  <depend>tf_transformations</depend>


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
