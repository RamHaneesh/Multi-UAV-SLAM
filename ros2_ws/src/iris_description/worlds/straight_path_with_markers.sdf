    <!-- ================= RUNWAY GROUND ================= -->
    <model name="runway_ground">
      <static>true</static>
      <pose>40 0 0 0 0 3.14159</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 8</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 8</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
            <pbr>
              <metal>
                <albedo_map>file://materials/textures/runway.png</albedo_map>
                <roughness>1.0</roughness>
                <metalness>0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= WALLS ================= -->

    <!-- LEFT WALL — single box, texture stretched across full length -->
    <model name="wall_left">
      <static>true</static>
      <pose>40 4 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>100 0.2 3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box><size>100 0.2 3</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
            <pbr>
              <metal>
                <albedo_map>file://materials/textures/plaster_bricks.jpg</albedo_map>
                <roughness>1.0</roughness>
                <metalness>0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- RIGHT WALL -->
    <model name="wall_right">
      <static>true</static>
      <pose>40 -4 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>100 0.2 3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box><size>100 0.2 3</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
            <pbr>
              <metal>
                <albedo_map>file://materials/textures/plaster_bricks.jpg</albedo_map>
                <roughness>1.0</roughness>
                <metalness>0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- BACK WALL -->
    <model name="wall_back">
      <static>true</static>
      <pose>90 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 8 3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box><size>0.2 8 3</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
            <pbr>
              <metal>
                <albedo_map>file://materials/textures/plaster_bricks.jpg</albedo_map>
                <roughness>1.0</roughness>
                <metalness>0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>


  <!-- ================= CHECKERBOARD FEATURE BOARDS ================= -->
  <!-- 15 boards, x=5 to x=78, randomly placed and rotated -->

