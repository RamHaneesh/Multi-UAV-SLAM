              <roughness>1.0</roughness><metalness>0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= PILLARS ================= -->
    <!--
      Corridor: 40m long (x=0 to x=40), 8m wide (y=-4 to y=4)
      UAV spawns at x=0, flies to x=40 and back = ~80m + turns ~= 100m trajectory (matches paper)
      Left pillars:  y=+1.5, at x=5,10,15,20,25,30,35,40  (8 pillars)
      Right pillars: y=-1.5, staggered at x=7,12,17,22,27,32,37,40  (8 pillars)
      Height: 1.75m (center z=0.875), tops at 1.75m
      UAV at 2.5m clears pillar tops by 0.75m
    -->

    <!-- LEFT SIDE (y=+1.5) -->
    <model name="pillar_L0">
      <static>true</static>
      <pose>5 1.5 0.875 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 1.75</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.6 0.6 1.75</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.0 0.0 0.0 1</specular>
            <pbr><metal><albedo_map>file://materials/media/wall3.png</albedo_map><roughness>1.0</roughness><metalness>0</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

