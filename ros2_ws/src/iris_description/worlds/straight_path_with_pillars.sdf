    <!-- ================= RUNWAY GROUND (40m x 8m, centered at x=20) ================= -->
    <model name="runway_ground">
      <static>true</static>
      <pose>20 0 0 0 0 3.14159</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>40 8</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>40 8</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
            <pbr><metal>
              <albedo_map>file://materials/textures/runway.png</albedo_map>
              <roughness>1.0</roughness><metalness>0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= WALLS ================= -->

    <model name="wall_left">
      <static>true</static>
      <pose>20 4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>40 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
            <pbr><metal>
              <albedo_map>file://materials/textures/plaster_bricks.jpg</albedo_map>
              <roughness>1.0</roughness><metalness>0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_right">
      <static>true</static>
      <pose>20 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
